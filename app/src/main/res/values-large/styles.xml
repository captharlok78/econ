        <item name="@android:attr/expandableListViewStyle">@style/EConTabBackgroundListaEspandibile</item>
        <item name="@android:attr/scrollViewStyle">@style/EConTabScrollView</item>
        <item name="@android:attr/windowBackground">@drawable/sfondo_app</item>
        <item name="@android:attr/autoCompleteTextViewStyle">@style/AutocompleteEditTextStyle</item>
        <item name="@android:attr/actionBarTabBarStyle">@style/EConTabActionBarTabBarStyle</item>
        -->
    </style>

