<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" >
     <item android:state_pressed="true" >
         
         <shape android:shape="rectangle"  >
              <padding android:left="5px" android:right="5px" android:top="5px" android:bottom="5px"/>
             <corners android:radius="1px" />
             <stroke android:width="1px" android:color="#88918c" />
             <gradient  android:angle="90"  android:startColor="#dddddd" android:endColor="#e7e7e7"  />            
         </shape>
     </item>
    <item android:state_focused="true">
        
         <shape android:shape="rectangle"  >
              <padding android:left="5px" android:right="5px" android:top="5px" android:bottom="5px"/>
             <corners android:radius="1px" />
             <stroke android:width="1px" android:color="#88918c" />
             <solid  android:color="#91a69d"/>       
         </shape>
     </item>  
    <item>
       
        <shape android:shape="rectangle"  >
            <padding android:left="5px" android:right="5px" android:top="5px" android:bottom="5px"/>
            
             <corners android:radius="1px" />
             <stroke android:width="1px" android:color="#88918c" />
             <gradient  android:angle="-90"  android:startColor="#FFFFFF" android:endColor="#e7e7e7" />             
         </shape>
     </item>
     
</selector>
