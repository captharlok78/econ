<?xml version="1.0" encoding="utf-8"?>
<!-- Pulsante a segmenti del disegno (Tubo / Cavo / Tubo+cavo): scelto = blu pieno, altrimenti bianco bordato -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/disegno_blu" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/disegno_blu_chiaro" />
            <stroke android:width="1dp" android:color="@color/disegno_blu" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="#B0BAC6" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
