<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" >
     <item android:state_pressed="true" >
         
         <shape android:shape="rectangle"  >
              <padding android:left="@dimen/margine" android:right="@dimen/margine" android:top="@dimen/margine" android:bottom="@dimen/margine"/>
         
           
             
             <gradient  android:angle="90"  android:startColor="#dddddd" android:endColor="#e7e7e7"  />            
         </shape>
     </item>
    <item android:state_focused="true">
        
         <shape android:shape="rectangle"  >
             <padding android:left="@dimen/margine" android:right="@dimen/margine" android:top="@dimen/margine" android:bottom="@dimen/margine"/>
            
             <corners android:radius="1px" />
             <stroke android:width="1px" android:color="#88918c" />
             <solid  android:color="#91a69d"/>       
         </shape>
     </item>  
    <item>
       
        <shape android:shape="rectangle"  >
            <padding android:left="@dimen/margine" android:right="@dimen/margine" android:top="@dimen/margine" android:bottom="@dimen/margine"/>
            
            <solid android:color="#cceeeded"/>
                   
         </shape>
     </item>
     
</selector>
