<?xml version="1.0" encoding="utf-8"?>
<!-- Campo dei modali senza TextInputLayout (EditText vecchi, EconDialogo.Stile): bordato e arrotondato come i campi del template form -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/econ_campo_bloccato" />
            <stroke android:width="1dp" android:color="@color/econ_divisore" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="2dp" android:color="@color/econ_primario" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#FFFFFF" />
            <stroke android:width="1dp" android:color="@color/econ_bordo_campo" />
        </shape>
    </item>
</selector>
