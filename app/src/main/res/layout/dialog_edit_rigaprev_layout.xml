<?xml version="1.0" encoding="utf-8"?>
<!-- Riga del preventivo: quantita', prezzo, ricalcolo da costo o listino (stile dei modali, STUDIO_MODALI_APP.md) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/campi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="4dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/linearCampi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_qta"
        style="@style/Econ.Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:hint="@string/quantita">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_qta"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:maxLength="6" android:selectAllOnFocus="true" android:nextFocusDown="@+id/editText_prezzo" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_prezzo"
        style="@style/Econ.Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginTop="12dp"
        android:hint="@string/prezzo">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_prezzo"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:maxLength="8" android:selectAllOnFocus="true" />
    </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/linearCampi0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_numop"
        style="@style/Econ.Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:hint="@string/numero_operatori">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_numop"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" android:maxLength="3" />
    </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <TextView
        style="@style/Econ.Dialogo.Etichetta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Prezzo da costo o da listino" />
    <LinearLayout
        android:id="@+id/linearCampi1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_przacq"
        style="@style/Econ.Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:hint="@string/prezzo_acquisto">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_przAcq"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:maxLength="8" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_ric"
        style="@style/Econ.Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:hint="@string/ricarico">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_ric"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:maxLength="5" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonRicalcola"
        style="@style/Econ.Pulsante.Icona"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/ricalcola_prezzo"
        android:tooltipText="@string/ricalcola_prezzo"
        app:icon="@drawable/ic_azione_ricalcola" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/linearCampi2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_przlis"
        style="@style/Econ.Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:hint="@string/prezzo_listino">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_przlis"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:maxLength="8" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_sco"
        style="@style/Econ.Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginTop="12dp"
        android:hint="@string/sconto">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_sco"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:maxLength="5" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonRicalcola1"
        style="@style/Econ.Pulsante.Icona"
        android:layout_width="48dp"
        android:layout_height="56dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/ricalcola_prezzo"
        android:tooltipText="@string/ricalcola_prezzo"
        app:icon="@drawable/ic_azione_ricalcola" />
    </LinearLayout>
</LinearLayout>
