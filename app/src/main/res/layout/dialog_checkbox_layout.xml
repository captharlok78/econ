<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="wrap_content" >

<RelativeLayout

    android:layout_marginLeft="@dimen/margine"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView

        android:text="@string/quantita"
        android:id="@+id/txtQta"
        style="@style/TestoNeroPiccolo"
        android:layout_centerVertical="true"
        android:layout_alignParentLeft="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <EditText
        android:layout_toRightOf="@+id/txtQta"
        android:id="@+id/editText_qta"
        android:ems="3"
        android:maxLength="3"
        android:gravity="right"
        android:inputType="number"
        android:text="1"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <TextView
        style="@style/TestoPiccolo"
        android:id="@+id/txtGiaPresenti"
        android:layout_toRightOf="@+id/editText_qta"
        android:layout_width="wrap_content"
        android:text=" (Già presenti in questo locale:)"
        android:layout_centerVertical="true"
        android:layout_height="wrap_content" />
</RelativeLayout>

    <CheckBox
        android:layout_marginTop="@dimen/margine"
        android:id="@+id/checkbox_ricorda"
style="@style/TestoNeroPiccolo"
        android:text="@string/non_mostrare_piu"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
         />

</LinearLayout>