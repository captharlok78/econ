<?xml version="1.0" encoding="utf-8"?>
<!--
    Sincronizzazione (SincronizzaActivity): solo due pulsanti a mezza riga, Scarica da server e Carica su server, con
    sopra data e ora dell'ultimo download e dell'ultimo upload. Le impostazioni sono in Impostazioni › Configurazione
    generale.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/econ_sfondo"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1565C0"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Indietro"
            android:onClick="chiudi"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/sincronizza"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Scarica -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textUltimoDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_standard"
                android:elevation="1dp"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="#212121"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/buttonScarica"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pulsante_grande"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:onClick="scarica"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/iconaScarica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <!-- smartphone in verticale: va su due righe centrate e il carattere si riduce se serve -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="Scarica da server"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="22sp"
                    app:autoSizeMinTextSize="14sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
        </LinearLayout>

        <!-- Carica -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textUltimoUpload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_standard"
                android:elevation="1dp"
                android:gravity="center"
                android:padding="12dp"
                android:textColor="#212121"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/buttonCarica"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pulsante_grande"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:gravity="center"
                android:onClick="carica"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/iconaCarica"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <!-- smartphone in verticale: va su due righe centrate e il carattere si riduce se serve -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="Carica su server"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="22sp"
                    app:autoSizeMinTextSize="14sp"
                    app:autoSizeTextType="uniform" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
