<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true" >

        <LinearLayout
            android:id="@+id/campi"
            style="@style/EConTabLinearLayoutMaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <RelativeLayout
                android:id="@+id/prima_riga"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margine" >

                <LinearLayout
                    android:id="@+id/riga_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:layout_toLeftOf="@+id/button_edit_cantiere"
                    android:orientation="vertical" >

                    <TextView
                        android:id="@+id/textView_cantiere"
                        style="@style/TestoIntestazioneNoPadding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cantiere" />

                    <TextView
                        android:id="@+id/editText_cantiere"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/button_edit_cantiere"
                    style="@style/bottoneListaGrande"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_bottone_rotondo"
                    android:onClick="modifica"
                    android:scaleType="fitXY"
                    android:src="@drawable/modifica" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/riga_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margine"
                android:layout_marginTop="@dimen/margine"
                android:orientation="vertical" >

                <TextView
                    android:id="@+id/textView_cliente"
                    style="@style/TestoIntestazioneNoPadding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cliente" />

                <TextView
                    android:id="@+id/editText_ragionesociale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/riga_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margine"
                android:layout_marginTop="@dimen/margine"
                android:orientation="vertical" >

                <LinearLayout
                    android:id="@+id/linear_indidrizzo_mappa_cant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" >

                    <TextView
                        android:id="@+id/textView_indirizzo"
                        style="@style/TestoIntestazioneNoPadding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/indirizzo" />
                     <Button
                        android:id="@+id/buttonMappa"
                        style="@style/bottoneLista"
                        
                        android:layout_marginLeft="@dimen/margine"
                        android:background="@drawable/mappa" />
                </LinearLayout>

                <TextView
                    android:id="@+id/editText_indirizzo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/riga_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margine"
                android:layout_marginTop="@dimen/margine"
                android:orientation="vertical" >

                <TextView
                    android:id="@+id/textView_capcittaprov"
                    style="@style/TestoIntestazioneNoPadding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cap_citta_provincia" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <TextView
                        android:id="@+id/editText_cap"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.25"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/editText_citta"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6" />

                    <TextView
                        android:id="@+id/editText_provincia"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.15"
                        android:singleLine="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/riga_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margine"
                android:layout_marginTop="@dimen/margine"
                android:orientation="vertical" >

                <TextView
                    android:id="@+id/textView_linea"
                    style="@style/TestoIntestazioneNoPadding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/linea_standard" />

                <TextView
                    android:id="@+id/editText_linea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/riga_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margine"
                android:layout_marginTop="@dimen/margine"
                android:orientation="vertical" >

                <TextView
                    android:id="@+id/textView_placca"
                    style="@style/TestoIntestazioneNoPadding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/placca_standard" />

                <TextView
                    android:id="@+id/editText_placca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/riga_11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margine"
                android:layout_marginTop="@dimen/margine"
                android:orientation="vertical" >

                <TextView
                    android:id="@+id/textView_note"
                    style="@style/TestoIntestazioneNoPadding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/note" />

                <TextView
                    android:id="@+id/editText_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>