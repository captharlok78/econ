<?xml version="1.0" encoding="utf-8"?>
<!--
    Linguetta "Dati cantiere" della scheda del cantiere, standard grafico (STANDARD_GRAFICO.md): testata di sezione con
    le azioni a icona (modifica, mappa) e dati in sola lettura (etichetta sopra, valore in grassetto). Linea e placca
    standard sono nella linguetta "Gestione elettrica" (GESTIONE_ELETTRICA.md).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/campi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <include
            android:id="@+id/sezione_dati"
            layout="@layout/sezione_standard" />

        <TextView
            style="@style/TestoIntestazioneNoPadding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cantiere" />

        <TextView
            android:id="@+id/editText_cantiere"
            style="@style/DatoValore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/TestoIntestazioneNoPadding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cliente" />

        <TextView
            android:id="@+id/editText_ragionesociale"
            style="@style/DatoValore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/TestoIntestazioneNoPadding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/indirizzo" />

        <TextView
            android:id="@+id/editText_indirizzo"
            style="@style/DatoValore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/TestoIntestazioneNoPadding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/cap_citta_provincia" />

        <TextView
            android:id="@+id/editText_luogo"
            style="@style/DatoValore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/TestoIntestazioneNoPadding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/note" />

        <TextView
            android:id="@+id/editText_note"
            style="@style/DatoValore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
