<?xml version="1.0" encoding="utf-8"?>
<!--
    Righe di preventivo e ordine (STUDIO_PREVENTIVI_ORDINI.md §6.5) con la grafica delle righe del rapportino: pulsanti
    "+ Articolo / + Lavoro / + Placca / + Nota" (Placca solo con Elettro), azioni a icona (associa codici, esporta), barra
    "modifiche da salvare" quando si cambiano quantita' o prezzi nella tabella, tabella standard con i gruppi per locale e
    i totali in fondo. Lo usano la scheda del documento (DocumentoActivity) e la scheda del cantiere (CantiereSplitActivity).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/tasti_prev_dett"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/pulsanti_righe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_articolo"
                style="@style/Econ.Pulsante.Tenue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/aggiungi_articolo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_lavoro"
                style="@style/Econ.Pulsante.Tenue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/aggiungi_manodopera" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_placca"
                style="@style/Econ.Pulsante.Tenue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/riga_placca" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_nota"
                style="@style/Econ.Pulsante.Tenue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="@string/aggiungi_nota" />
        </LinearLayout>

        <!-- azioni a icona (FaIcone.azione): associa codici (Elettro), esporta -->
        <LinearLayout
            android:id="@+id/azioni_righe_documento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- quantita'/prezzi cambiati nella tabella e non ancora salvati -->
    <LinearLayout
        android:id="@+id/barra_modifiche"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_filtri"
        android:backgroundTint="#FFF8E1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/textViewModificati"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Righe modificate, non ancora salvate"
            android:textColor="#8D6E00"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_salva_prev"
            style="@style/Econ.Pulsante"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/salva"
            app:icon="@drawable/ic_form_salva"
            app:iconGravity="textStart" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tabella standard: testata fissa + lista (dettaglio_tabella_standard.xml) -->
        <include
            android:id="@+id/tabella_dettaglio"
            layout="@layout/dettaglio_tabella_standard"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- locale delle righe in vista mentre si scorre -->
        <LinearLayout
            android:id="@+id/LinearLayout_titolocorrente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="44dp"
            android:background="@drawable/bg_titolo_arrotondato"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/localecorrente"
                style="@style/Testo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:textColor="#212121" />
        </LinearLayout>
    </FrameLayout>

    <!-- totali in fondo, sempre visibili -->
    <LinearLayout
        android:id="@+id/relative_totale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F4F6FA"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/textViewTotaleImponibile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/econ_testo_secondario"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textViewTotaleIva"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:textColor="@color/econ_testo_secondario"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textViewTotaleImporto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:textColor="#1565C0"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
