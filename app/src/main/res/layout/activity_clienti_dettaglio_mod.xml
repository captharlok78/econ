<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#F5F5F5">

    <RelativeLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

        <include
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            layout="@layout/header_dettaglio_standard" />

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/footer_dettaglio"
            android:layout_below="@+id/header"

             >

            <LinearLayout
                android:id="@+id/campi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_filtri"
                android:layout_margin="8dp"
                android:padding="10dp" >

                <TextView
                    style="@style/TestoIntestazione"
                    android:id="@+id/textView_ragionesociale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ragione_sociale"
                     />

                <EditText
                    android:id="@+id/editText_ragionesociale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_input_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:ems="10"
                    android:maxLength="100"
                    android:nextFocusRight="@+id/editText_codice"
                    />

                <TextView
                    android:layout_marginTop="10dp"
                    style="@style/TestoIntestazione"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/codice"
                    android:id="@+id/textView_codice" />
                <EditText
                    android:id="@+id/editText_codice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_input_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:ems="10"
                    android:maxLength="7"
                    android:nextFocusRight="@+id/editText_indirizzo"
                    />
                <TextView
                    style="@style/TestoIntestazione"
                    android:id="@+id/textView_indirizzo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/indirizzo"
                     />

                <EditText
                    android:id="@+id/editText_indirizzo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_input_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:ems="10"
                    android:maxLength="255"
                    android:nextFocusRight="@+id/editText_cap"
                    />

                <TextView
                    style="@style/TestoIntestazione"
                    android:id="@+id/textView_capcittaprov"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/cap_citta_provincia"
                     />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <EditText
                        android:id="@+id/editText_cap"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.25"
                        android:layout_marginEnd="4dp"
                        android:minHeight="40dp"
                        android:background="@drawable/bg_input_outline"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:ems="10"
                        android:inputType="number"
                        android:maxLength="5"
                        android:singleLine="true"
                        android:nextFocusForward="@+id/editText_citta"
                        android:nextFocusDown="@+id/editText_citta"
                        android:nextFocusUp="@+id/editText_citta"
                        android:nextFocusRight="@+id/editText_citta"
                        />

                    <EditText
                        android:id="@+id/editText_citta"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.6"
                        android:layout_marginEnd="4dp"
                        android:minHeight="40dp"
                        android:background="@drawable/bg_input_outline"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:ems="10"
                        android:maxLength="70"
                        android:singleLine="true"
                        android:nextFocusRight="@+id/editText_provincia"
                        />

                    <EditText
                        android:id="@+id/editText_provincia"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.15"
                        android:minHeight="40dp"
                        android:background="@drawable/bg_input_outline"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:ems="10"
                        android:maxLength="2"
                        android:singleLine="true"
                        android:nextFocusRight="@+id/editText_cf"
                        />
                </LinearLayout>

                <TextView
                    style="@style/TestoIntestazione"
                    android:id="@+id/textView_cf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/codice_fiscale"
                     />

                <EditText
                    android:id="@+id/editText_cf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_input_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:ems="10"
                    android:maxLength="16"
                    android:singleLine="true"
                    android:nextFocusRight="@+id/editText_partitaiva"
                    />

                <TextView
                    style="@style/TestoIntestazione"
                    android:id="@+id/textView_partitaiva"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/partita_iva"
                     />

                <EditText
                    android:id="@+id/editText_partitaiva"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_input_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:ems="10"
                    android:maxLength="50"
                    android:singleLine="true"
                    android:nextFocusRight="@+id/editText_cellulare1"
                    />

                <TextView
                    style="@style/TestoIntestazione"
                    android:id="@+id/textView_cellulari"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/cellulari"
                     />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <EditText
                        android:id="@+id/editText_cellulare1"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:layout_marginEnd="4dp"
                        android:minHeight="40dp"
                        android:background="@drawable/bg_input_outline"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:ems="10"
                        android:inputType="text"
                        android:maxLength="20"
                        android:singleLine="true"
                        android:nextFocusRight="@+id/editText_cellulare2"/>

                    <EditText
                        android:id="@+id/editText_cellulare2"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:minHeight="40dp"
                        android:background="@drawable/bg_input_outline"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:ems="10"
                        android:maxLength="20"
                        android:inputType="text"
                        android:singleLine="true"
                        android:nextFocusRight="@+id/editText_telefono"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lineartelefonomail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <LinearLayout
                        android:id="@+id/lineartelefono"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:layout_marginEnd="4dp"
                        android:orientation="vertical" >

                        <TextView
                            style="@style/TestoIntestazione"
                            android:id="@+id/textView_telefono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/telefono"
                             />

                        <EditText
                            android:id="@+id/editText_telefono"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="40dp"
                            android:background="@drawable/bg_input_outline"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:ems="10"
                            android:maxLength="20"
                            android:singleLine="true"
                            android:nextFocusRight="@+id/editText_mail"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linearmail"
                        android:layout_width="0sp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:orientation="vertical" >

                        <TextView
                            style="@style/TestoIntestazione"
                            android:id="@+id/textView_iva"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/iva"
                             />

                        <pfa.app.econtab.views.EConTabSpinner
                            android:id="@+id/spinner_iva"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            />

                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/TestoIntestazione"
                    android:id="@+id/textView_mail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/mail"
                     />

                <EditText
                    android:id="@+id/editText_mail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_input_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:ems="10"
                    android:inputType="textEmailAddress"
                    android:maxLength="50"
                    android:singleLine="true"
                    android:nextFocusRight="@+id/editText_note"/>

                <TextView
                    style="@style/TestoIntestazione"
                    android:id="@+id/textView_note"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/note"
                     />

                <EditText
                    android:id="@+id/editText_note"
                    android:gravity="top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="8dp"
                    android:ems="10"
                    android:minLines="2"
                    android:maxLength="255"
                    android:nextFocusRight="@+id/editText_ragionesociale"
                    />
            </LinearLayout>
        </ScrollView>

        <include
            android:id="@+id/footer_dettaglio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            layout="@layout/footer_dett" />
    </RelativeLayout>

</FrameLayout>