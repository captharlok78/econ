<?xml version="1.0" encoding="utf-8"?>
<!--
    Dettaglio di un elemento non componibile (aperto dal disegno) nella grafica del disegno: testata blu, card Dati con
    le azioni (a costo, modifica, nota, collegamento), card Punti di comando e Collegamenti. Gli id restano quelli di prima.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contenitore"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/disegno_sfondo"
    android:orientation="vertical">

    <include layout="@layout/testata_disegno" />

    <ScrollView
        android:id="@+id/scroll_relazioni"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                style="@style/Disegno.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/linearCampi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/linearNumero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView_etichetta"
                            style="@style/Disegno.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/etichetta" />

                        <EditText
                            android:id="@+id/editText_etichetta"
                            style="@style/Disegno.Campo"
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="6" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linearAltezza"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textView_altezza"
                            style="@style/Disegno.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/altezza" />

                        <EditText
                            android:id="@+id/editText_altezza"
                            style="@style/Disegno.Campo"
                            android:layout_width="96dp"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="6" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_salva_mod"
                        style="@style/Econ.Pulsante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:onClick="salvaDatiGenerali"
                        android:text="@string/salva" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/linear_pulsanti"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/button_non_conteggiare"
                            android:layout_width="52dp"
                            android:layout_height="36dp"
                            android:layout_marginRight="4dp"
                            android:background="@drawable/bg_disegno_conteggiato"
                            android:onClick="nonConteggiare"
                            android:padding="8dp"
                            android:scaleType="fitCenter" />

                        <ImageButton
                            android:id="@+id/button_edit_elemento"
                            style="@style/Disegno.Azione"
                            android:contentDescription="@string/modifica"
                            android:onClick="apriModifica"
                            android:src="@drawable/modifica"
                            android:tint="@color/disegno_testo2" />

                        <ImageButton
                            android:id="@+id/button_nota"
                            style="@style/Disegno.Azione"
                            android:contentDescription="@string/note"
                            android:onClick="apriNota"
                            android:src="@drawable/note"
                            android:tint="@color/disegno_testo2" />

                        <ImageButton
                            android:id="@+id/button_relazioni"
                            style="@style/Disegno.Azione"
                            android:contentDescription="@string/nuovo_collegamento"
                            android:onClick="nuovoCollegamento"
                            android:src="@drawable/nuova_relazione"
                            android:tint="@color/disegno_testo2" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/nota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/disegno_testo2"
                    android:textSize="13sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <com.ncfsistemi.econ.disegno.MaterialiElementoView
                android:id="@+id/materiali_elemento"
                style="@style/Disegno.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/linear_collegamenti"
                style="@style/Disegno.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/separatore"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/textView_relazioni"
                    style="@style/Disegno.TitoloSezione"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/punti_di_comando" />

                <LinearLayout
                    android:id="@+id/lista_relazioni_logiche"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/descrizione"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_disegno_non_conteggiato"
                        android:gravity="center"
                        android:minHeight="44dp"
                        android:onClick="nuovaRelazione"
                        android:text="@string/aggiungi_punto_comando"
                        android:textAllCaps="false"
                        android:textColor="@color/disegno_blu"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textView_collegamenti"
                    style="@style/Disegno.TitoloSezione"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/collegamenti" />

                <LinearLayout
                    android:id="@+id/lista_relazioni"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
