<?xml version="1.0" encoding="utf-8"?>
<!--
    Nuovo / modifica elemento (gestione elettrica) con l'aspetto delle form del template (STUDIO_FORM_APP.md §7.7): testata
    standard, campi in una card con etichette piccole e campi bordati, piede Annulla/Salva. Gli id sono quelli di sempre.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/econ_sfondo"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/header_dettaglio_standard" />

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.card.MaterialCardView
                style="@style/Econ.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp">

            <LinearLayout
                android:id="@+id/campi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp" >

                <TextView
                    android:id="@+id/textView_categoria"
                    style="@style/TestoSezione"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                   android:text="Categoria"
                    android:layout_marginBottom="@dimen/margine"
                    android:textAllCaps="false" />

                <LinearLayout
                    android:id="@+id/linear_icona_nome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <LinearLayout
                        android:id="@+id/linear_icona"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_icona"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margine"
                            android:text="@string/icona"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/imageButtonIcona"
                            android:layout_width="@dimen/larghezza_icona_con_padding"
                            android:layout_height="@dimen/larghezza_icona_con_padding"
                            android:background="@drawable/button_econ_bianco"

                            android:onClick="azioniIcona"
                            android:scaleType="fitCenter"
                            android:src="@drawable/no_image" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linear_nome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/margine"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_nome"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/elemento" />

                        <EditText
                            android:background="@drawable/campo_bordato"
                            android:textSize="16sp"
                            android:id="@+id/editText_nome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ems="10"
                            android:maxLength="50" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linear_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <LinearLayout
                        android:id="@+id/linear_preferito"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_preferito"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margine"
                            android:text="@string/preferito_sn" />

                        <Switch
                            android:id="@+id/switch_preferito"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textOff="O"
                            android:textOn="I"
                            android:thumbTextPadding="@dimen/altezza_campo" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/linear_placca"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_placca"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margine"
                            android:text="@string/placca_sn" />

                        <Switch
                            android:id="@+id/switch_placca"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textOff="O"
                            android:textOn="I"
                            android:thumbTextPadding="@dimen/altezza_campo" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/linear_usa_linea_locale"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_usa_linea_locale"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margine"
                            android:text="@string/usa_linea_placca_predef" />

                        <Switch
                            android:id="@+id/switch_usa_linea_locale"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textOff="O"
                            android:textOn="I"
                            android:thumbTextPadding="@dimen/altezza_campo" />
                    </LinearLayout>

                </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/linear_linea_placca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >
                <LinearLayout
                    android:id="@+id/linear_linea"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:orientation="vertical" >

                    <TextView
                        android:id="@+id/textView_linea"
                        style="@style/Econ.Etichetta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margine"
                        android:text="@string/linea" />

                    <com.ncfsistemi.econ.views.EconSpinner
                        android:id="@+id/econSpinner_linea"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" >
                    </com.ncfsistemi.econ.views.EconSpinner>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/linear_placca_sel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.5"
                    android:orientation="vertical" >

                    <TextView
                        android:id="@+id/textView_placca_sel"
                        style="@style/Econ.Etichetta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margine"
                        android:text="@string/placca" />

                    <com.ncfsistemi.econ.views.EconSpinner
                        android:id="@+id/econSpinner_placca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" >
                    </com.ncfsistemi.econ.views.EconSpinner>
                </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/linear_udm_altezza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <LinearLayout
                        android:id="@+id/linear_udm"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_udm"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margine"
                            android:text="@string/unita_misura" />

                        <com.ncfsistemi.econ.views.EconSpinner
                            android:id="@+id/econSpinner_udm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" >
                        </com.ncfsistemi.econ.views.EconSpinner>
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.05" />

                    <LinearLayout
                        android:id="@+id/linear_altezza"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_altezza"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margine"
                            android:text="@string/altezza" />

                        <EditText
                            android:background="@drawable/campo_bordato"
                            android:textSize="16sp"
                            android:id="@+id/editText_altezza"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ems="4"
                            android:inputType="number"
                            android:maxLength="6" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linear_tubo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <LinearLayout
                        android:id="@+id/linear_tipotubo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_tipotubo"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margine"
                            android:text="@string/tubo" />

                        <com.ncfsistemi.econ.views.EconSpinner
                            android:id="@+id/econSpinner_tubo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" >
                        </com.ncfsistemi.econ.views.EconSpinner>
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.05" />

                    <LinearLayout
                        android:id="@+id/linear_metritubo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_metritubo"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margine"
                            android:text="@string/metritubo" />

                        <EditText
                            android:background="@drawable/campo_bordato"
                            android:textSize="16sp"
                            android:id="@+id/editText_metritubo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ems="4"
                            android:inputType="numberDecimal"
                            android:maxLength="6" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linear_cavo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <LinearLayout
                        android:id="@+id/linear_tipocavo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.65"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_tipocavo"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margine"
                            android:text="@string/cavo" />

                        <com.ncfsistemi.econ.views.EconSpinner
                            android:id="@+id/econSpinner_cavo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" >
                        </com.ncfsistemi.econ.views.EconSpinner>
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.05" />

                    <LinearLayout
                        android:id="@+id/linear_metricavo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.3"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_metricavo"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margine"
                            android:text="@string/metricavo" />

                        <EditText
                            android:background="@drawable/campo_bordato"
                            android:textSize="16sp"
                            android:id="@+id/editText_metricavo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ems="4"
                            android:inputType="numberDecimal"
                            android:maxLength="6" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/linear_icona_composizione"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" >

                    <LinearLayout
                        android:id="@+id/linear_composizione"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:orientation="vertical" >

                        <TextView
                            android:id="@+id/textView_composizione"
                            style="@style/Econ.Etichetta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margine"
                            android:text="@string/composizione" />

                        <ImageButton
                            android:id="@+id/imageButtonComposizione"
                            android:layout_width="@dimen/larghezza_componente"
                            android:layout_height="@dimen/larghezza_componente"
                            android:layout_marginTop="@dimen/margine"
                            android:background="@drawable/bg_bottone_rotondo"
                            android:onClick="apriComposizione"
                            android:scaleType="fitXY"
                            android:src="@drawable/composizione" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </ScrollView>

    <include
        android:id="@+id/footer_dettaglio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/footer_dett" />

</LinearLayout>
