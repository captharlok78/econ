<?xml version="1.0" encoding="utf-8"?>
<!-- Codice articolo di una riga del preventivo (associazione al listino) (stile dei modali, STUDIO_MODALI_APP.md) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/campi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="4dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/linearFornitore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView_fornitore"
            style="@style/Econ.Dialogo.Etichetta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="@string/fornitore" />

        <com.ncfsistemi.econ.views.EconSpinner
            android:id="@+id/econSpinnerFornitore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/linearLinea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView_linea"
            style="@style/Econ.Dialogo.Etichetta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="@string/linea" />

        <com.ncfsistemi.econ.views.EconSpinner
            android:id="@+id/econSpinnerLinea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView
        android:id="@+id/textView_linea_originale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Linea originale: "
        android:textColor="@color/econ_testo_secondario"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_codice"
        style="@style/Econ.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/codice_articolo"
        app:placeholderText="@string/messaggio_seleziona_inserisci_codice">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/editText_codice"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:completionThreshold="1"
            android:inputType="textVisiblePassword"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <requestFocus />
        </com.google.android.material.textfield.MaterialAutoCompleteTextView>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_descrizione"
        style="@style/Econ.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/descrizione">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_descrizione"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences" android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>
    <TextView
        android:id="@+id/textViewNotaBene"
        style="@style/Econ.Dialogo.Etichetta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/prezzi_listino" />
    <LinearLayout
        android:id="@+id/linearPrezzo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_przacq"
        style="@style/Econ.Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:hint="@string/prezzo_acquisto">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_przAcq"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:maxLength="8" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_przlis"
        style="@style/Econ.Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:hint="@string/prezzo_listino">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_przLis"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:maxLength="8" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_sconto"
        style="@style/Econ.Campo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.7"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:hint="@string/sconto">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_sconto"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:maxLength="5" />
    </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkBoxAggiorna"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/aggiorna_prezzi_preventivo"
        android:textColor="@color/econ_testo_corpo" />
</LinearLayout>
