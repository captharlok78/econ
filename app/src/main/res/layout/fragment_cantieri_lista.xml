<?xml version="1.0" encoding="utf-8"?>
<!--
    Cantieri e' incorporato sia a schermo intero (CantieriActivity) sia come tab dentro
    ClientiDettaglioActivity: in entrambi i casi la testata (indietro|titolo|filtro|nuovo)
    e' quella standard condivisa con tutti gli altri moduli; quando incorporato come tab
    indietro/titolo vengono nascosti da CantieriDefinition.mostraBarraTitolo() perche'
    ridondanti con la tab del contenitore.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/header_lista_standard" />

    <!--
        Form filtri: e' l'unica cosa visibile all'apertura del modulo (nessun caricamento
        dati finche' non si preme uno dei 3 pulsanti sotto). Si nasconde non appena parte
        una ricerca vera e propria.
    -->
    <LinearLayout
        android:id="@+id/cardFiltri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_filtri"
        android:layout_margin="8dp"
        android:padding="10dp">

        <EditText
            android:id="@+id/editText_filtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:background="@drawable/bg_input_outline"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:hint="Cerca per nome, indirizzo o città"
            android:imeOptions="actionSearch"
            android:singleLine="true" />

        <include layout="@layout/filtri_azioni_standard" />

    </LinearLayout>

    <!--
        Testata tabella: popolata a runtime da EconListaStandardController a partire
        dalle colonne del modulo. Visibile solo a ricerca avviata, come barraPaginazione.
    -->
    <LinearLayout
        android:id="@+id/headerTabella"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#EEEEEE"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone" />

    <View
        android:id="@+id/headerBorder"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginBottom="8dp"
        android:background="#000000"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/wrapper_lista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/textViewNessunDato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:text="@string/nessun_dato_trovato"
            android:textColor="#999999"
            android:textSize="14sp"
            android:visibility="gone" />
    </RelativeLayout>

    <include layout="@layout/barra_paginazione_standard" />

</LinearLayout>
