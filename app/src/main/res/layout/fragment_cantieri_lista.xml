<?xml version="1.0" encoding="utf-8"?>
<!--
    Cantieri e' incorporato sia a schermo intero (CantieriActivity, che fornisce la sua
    barra blu con indietro/titolo) sia come tab dentro ClientiDettaglioActivity (che non ha
    una barra propria): per questo qui non c'e' alcuna barra colorata/titolo/indietro, solo
    le icone filtro/nuovo, coerenti con lo standard usato da Clienti.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="4dp">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/buttonToggleFiltri"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_filter"
            android:scaleType="center"
            android:tint="#1565C0"
            android:contentDescription="Filtra" />

        <ImageButton
            android:id="@+id/buttonnuovo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_add"
            android:scaleType="fitCenter"
            android:tint="#1565C0"
            android:onClick="nuovoCantiere"
            android:contentDescription="@string/nuovo" />
    </LinearLayout>

    <!--
        Form filtri: e' l'unica cosa visibile all'apertura del modulo (nessun caricamento
        dati finche' non si preme uno dei 3 pulsanti sotto). Si nasconde non appena parte
        una ricerca vera e propria.
    -->
    <LinearLayout
        android:id="@+id/cardFiltri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_filtri"
        android:layout_margin="8dp"
        android:padding="10dp">

        <EditText
            android:id="@+id/editText_filtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:background="@drawable/bg_input_outline"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:hint="Cerca per nome, indirizzo o città"
            android:imeOptions="actionSearch"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonCerca"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:text="@string/cerca"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:backgroundTint="#1565C0" />

            <Button
                android:id="@+id/buttonResetFiltri"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/reset_filtri"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:backgroundTint="#E0E0E0" />

            <Button
                android:id="@+id/buttonUltimiGestiti"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:text="@string/ultimi_gestiti"
                android:textColor="#1565C0"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:backgroundTint="#E0E0E0" />

        </LinearLayout>

    </LinearLayout>

    <!--
        Testata tabella: popolata a runtime da EConTabListaStandardController a partire
        dalle colonne del modulo. Visibile solo a ricerca avviata, come barraPaginazione.
    -->
    <LinearLayout
        android:id="@+id/headerTabella"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#EEEEEE"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone" />

    <View
        android:id="@+id/headerBorder"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginBottom="8dp"
        android:background="#000000"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/wrapper_lista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/textViewNessunDato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:text="@string/nessun_dato_trovato"
            android:textColor="#999999"
            android:textSize="14sp"
            android:visibility="gone" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/barraPaginazione"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/textViewPaginaInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#666666"
            android:text="" />

        <EditText
            android:id="@+id/editTextRisultatiPerPagina"
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:gravity="center"
            android:background="@drawable/bg_input_outline"
            android:inputType="number"
            android:maxLength="3"
            android:singleLine="true"
            android:textSize="12sp"
            android:textColor="#1565C0"
            android:imeOptions="actionDone" />

        <TextView
            android:id="@+id/textViewPaginaInfo2"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:textSize="12sp"
            android:textColor="#666666"
            android:text="" />

        <ImageButton
            android:id="@+id/buttonPaginaPrec"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back"
            android:tint="#1565C0"
            android:contentDescription="Pagina precedente" />

        <ImageButton
            android:id="@+id/buttonPaginaSucc"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_forward"
            android:tint="#1565C0"
            android:contentDescription="Pagina successiva" />

    </LinearLayout>

</LinearLayout>
