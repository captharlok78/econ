<?xml version="1.0" encoding="utf-8"?>
<!--
    Preventivi/Ordini: come Cantieri, incorporato a schermo intero (PreventiviActivity/
    OrdiniActivity), con la testata standard condivisa (indietro|titolo|filtro|nuovo) resa
    direttamente dal fragment. Le righe non sono semplici colonne di testo (hanno un
    pulsante Azioni con logica di business per riga), quindi il modulo usa un adapter
    personalizzato (PreventiviAdapter) e non mostra la testata ordinabile
    (isTabellare()=false in PreventiviDefinition), pur restando su form filtri di default/
    paginazione/righe alternate condivise.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/header_lista_standard" />

    <LinearLayout
        android:id="@+id/cardFiltri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_filtri"
        android:layout_margin="8dp"
        android:padding="10dp">

        <!-- Ricerca cliente: autocomplete, ma con lo stesso id/comportamento standard
             (editText_filtra) cosi' il controller gestisce IME-search/reset come altrove. -->
        <AutoCompleteTextView
            android:id="@+id/editText_filtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:background="@drawable/bg_input_outline"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:hint="@string/cerca_cliente_2"
            android:imeOptions="actionSearch"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <com.ncfsistemi.econ.views.EconSpinner
                android:id="@+id/econSpinner_filtroAnno"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:layout_height="wrap_content" />

            <com.ncfsistemi.econ.views.EconSpinner
                android:id="@+id/econSpinner_filtroStato"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <include layout="@layout/filtri_azioni_standard" />

    </LinearLayout>

    <!-- Testata non usata (isTabellare()=false): resta sempre nascosta. -->
    <LinearLayout
        android:id="@+id/headerTabella"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#EEEEEE"
        android:visibility="gone" />

    <View
        android:id="@+id/headerBorder"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#000000"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/wrapper_lista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/textViewNessunDato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="32dp"
            android:text="@string/nessun_dato_trovato"
            android:textColor="#999999"
            android:textSize="14sp"
            android:visibility="gone" />
    </RelativeLayout>

    <include layout="@layout/barra_paginazione_standard" />

</LinearLayout>
