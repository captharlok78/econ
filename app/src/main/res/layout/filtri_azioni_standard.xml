<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra azioni standard della form filtri: Cerca | Reset filtri | Ultimi N, con i pulsanti delle form (Cerca pieno,
    gli altri bordati). E' identica (per default) in ogni modulo, incluso via <include> dentro il rispettivo cardFiltri.
    "Ultimi N" e' gestito interamente da EconListaStandardController: visibile solo se
    la EconListaStandardDefinition del modulo fornisce un getOrdineRecenti() non nullo -
    un modulo non deve toccare questo XML per mostrarlo/nasconderlo, basta sovrascrivere
    (o non sovrascrivere) quel metodo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCerca"
        style="@style/Econ.Pulsante"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:text="@string/cerca"
        app:icon="@drawable/ic_cerca"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonResetFiltri"
        style="@style/Econ.Pulsante.Secondario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:text="@string/reset_filtri" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonUltimiGestiti"
        style="@style/Econ.Pulsante.Secondario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_weight="1"
        android:text="@string/ultimi_gestiti" />

</LinearLayout>
