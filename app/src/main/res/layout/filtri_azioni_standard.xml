<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra azioni standard della form filtri: Cerca | Reset filtri | Ultimi N. E' identica
    (per default) in ogni modulo, incluso via <include> dentro il rispettivo cardFiltri.
    "Ultimi N" e' gestito interamente da EConTabListaStandardController: visibile solo se
    la EConTabListaStandardDefinition del modulo fornisce un getOrdineRecenti() non nullo -
    un modulo non deve toccare questo XML per mostrarlo/nasconderlo, basta sovrascrivere
    (o non sovrascrivere) quel metodo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:orientation="horizontal">

    <Button
        android:id="@+id/buttonCerca"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="44dp"
        android:layout_marginEnd="4dp"
        android:text="@string/cerca"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:backgroundTint="#1565C0" />

    <Button
        android:id="@+id/buttonResetFiltri"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:text="@string/reset_filtri"
        android:textColor="#1565C0"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:backgroundTint="#E0E0E0" />

    <Button
        android:id="@+id/buttonUltimiGestiti"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:text="@string/ultimi_gestiti"
        android:textColor="#1565C0"
        android:textSize="13sp"
        android:textAllCaps="false"
        android:backgroundTint="#E0E0E0" />

</LinearLayout>
