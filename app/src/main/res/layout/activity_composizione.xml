<?xml version="1.0" encoding="utf-8"?>
<!-- Componi (aperta dal disegno): grafica del disegno, testata blu + card Dati e Composizione (gli id restano quelli di prima) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contenitore"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/disegno_sfondo"
    android:orientation="vertical">

    <include layout="@layout/testata_disegno" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/linearCampi"
            style="@style/Disegno.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/linearNumero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView_etichetta"
                    style="@style/Disegno.Etichetta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/etichetta" />

                <EditText
                    android:id="@+id/editText_etichetta"
                    style="@style/Disegno.Campo"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearAltezza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView_altezza"
                    style="@style/Disegno.Etichetta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/altezza" />

                <EditText
                    android:id="@+id/editText_altezza"
                    style="@style/Disegno.Campo"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearMetriCavo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView_MetriCavo"
                    style="@style/Disegno.Etichetta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metricavo" />

                <EditText
                    android:id="@+id/editText_MetriCavo"
                    style="@style/Disegno.Campo"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linearMetriTubo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="12dp"
                android:visibility="gone"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView_MetriTubo"
                    style="@style/Disegno.Etichetta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/metritubo" />

                <EditText
                    android:id="@+id/editText_MetriTubo"
                    style="@style/Disegno.Campo"
                    android:layout_width="96dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="6" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_salva_mod"
                style="@style/Econ.Pulsante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="salvaDatiGenerali"
                android:text="@string/salva" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/linear_pulsanti"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/button_edit_elemento"
                    style="@style/Disegno.Azione"
                    android:contentDescription="@string/modifica"
                    android:onClick="apriModifica"
                    android:src="@drawable/modifica"
                    android:tint="@color/disegno_testo2" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_dettaglio"
            style="@style/Disegno.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/separatore"
                style="@style/Disegno.TitoloSezione"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/composizione" />

            <HorizontalScrollView
                android:id="@+id/scroll_scatola"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/linear_scatola"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_disegno_campo"
                    android:divider="@drawable/divider"
                    android:padding="6dp"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/aggiungi_scatola"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/altezza_scatola"
                        android:background="@drawable/bg_disegno_non_conteggiato"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:onClick="selezionaScatola"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text="@string/seleziona_scatola"
                        android:textColor="@color/disegno_blu"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <ListView
                android:id="@+id/listView_componenti"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:fastScrollEnabled="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
