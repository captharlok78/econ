<?xml version="1.0" encoding="utf-8"?>
<!--
    Scheda di preventivo e ordine (STUDIO_PREVENTIVI_ORDINI.md §6.5) con l'aspetto del rapportino: testata standard con lo
    stato; sezione "Preventivo"/"Ordine" (dati del documento, matita per modificarli) e sezione "Righe" (pulsanti, tabella
    e totali, PreventivoDettaglioFragment) a fisarmonica; barra bianca con Chiudi · Apri nel cantiere. DocumentoActivity.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/econ_sfondo"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/header_dettaglio_standard" />

        <TextView
            android:id="@+id/badge_stato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:elevation="5dp"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/corpo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_testata"
            style="@style/Econ.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="2dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <include
                    android:id="@+id/sezione_testata"
                    layout="@layout/sezione_standard" />

                <ScrollView
                    android:id="@+id/scroll_testata"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/campi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_righe"
            style="@style/Econ.Card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="12dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <include
                    android:id="@+id/sezione_righe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    layout="@layout/sezione_standard" />

                <FrameLayout
                    android:id="@+id/contenuto_righe"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/barra_pulsanti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_annulla"
                style="@style/Econ.Pulsante.Secondario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:onClick="annulla"
                android:text="@string/chiudi" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_cantiere"
                style="@style/Econ.Pulsante.Secondario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Apri nel cantiere" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_crea_ordine"
                style="@style/Econ.Pulsante"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/trasforma_in_ordine" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/footer" />
</LinearLayout>
