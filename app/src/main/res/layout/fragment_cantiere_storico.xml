<?xml version="1.0" encoding="utf-8"?>
<!--
    Linguette "Rapportini" e "Materiali" della scheda del cantiere (STORICO_CANTIERE.md): testata di sezione standard,
    riepilogo, tabella a colonne costruita da CantiereStoricoFragment e nota sullo storico del tablet.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <include
            android:id="@+id/sezione_storico"
            layout="@layout/sezione_standard" />

        <TextView
            android:id="@+id/textRiepilogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textColor="#212121"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/tabellaStorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/textNotaStorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textColor="#757575"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
