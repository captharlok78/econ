<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/campi"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/altezza_campo"
    android:orientation="vertical"
    android:padding="@dimen/margine" >

    <LinearLayout
        android:id="@+id/linearLinea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/textView_linea"
            style="@style/TestoIntestazione"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/linea" />

        <pfa.app.econtab.views.EConTabSpinner
            android:id="@+id/econtabSpinnerLinea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >
        </pfa.app.econtab.views.EConTabSpinner>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearPlacca"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/textView_placca"
            style="@style/TestoIntestazione"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placca" />

       <pfa.app.econtab.views.EConTabSpinner
            android:id="@+id/econtabSpinnerPlacca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >
        </pfa.app.econtab.views.EConTabSpinner>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearModuli"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <TextView
            android:id="@+id/textView_moduli"
            style="@style/TestoIntestazione"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/numero_moduli" />

        <EditText
            android:id="@+id/editText_moduli"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ems="3"
            android:inputType="number"
            android:maxLength="2"
            android:maxLines="1" />
    </LinearLayout>

</LinearLayout>