<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <include
        android:id="@+id/footerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/footer" />

    <!--
        Tutta la schermata (header, lista, barra paginazione) sta in un'unica colonna
        verticale ancorata sopra il footer: evita di dover incrociare i vincoli di
        RelativeLayout con una view nascosta (footerview è visibility=gone).
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@+id/footerview"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Barra standard: indietro | titolo | filtro | nuovo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:background="#1565C0"
                android:elevation="4dp">

                <ImageButton
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_back"
                    android:onClick="indietro"
                    android:contentDescription="Indietro" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/clienti"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginStart="4dp" />

                <ImageButton
                    android:id="@+id/buttonToggleFiltri"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_filter"
                    android:scaleType="center"
                    android:onClick="toggleFiltri"
                    android:contentDescription="Filtra" />

                <ImageButton
                    android:id="@+id/buttonnuovo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_add"
                    android:scaleType="fitCenter"
                    android:tint="#FFFFFF"
                    android:onClick="nuovoCliente"
                    android:contentDescription="@string/nuovo" />
            </LinearLayout>

            <!--
                Form filtri: è l'unica cosa visibile all'apertura del modulo (nessun
                caricamento dati finché non si preme uno dei 3 pulsanti sotto). Si
                nasconde non appena parte una ricerca vera e propria.
            -->
            <LinearLayout
                android:id="@+id/cardFiltri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_filtri"
                android:layout_margin="8dp"
                android:padding="10dp">

                <EditText
                    android:id="@+id/editText_filtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_input_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:hint="@string/cerca_cliente"
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />

                <!-- Barra azioni: Cerca / Reset filtri / Ultimi 20 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/buttonCerca"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/cerca"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#1565C0" />

                    <Button
                        android:id="@+id/buttonResetFiltri"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/reset_filtri"
                        android:textColor="#1565C0"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#E0E0E0" />

                    <Button
                        android:id="@+id/buttonUltimiGestiti"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:layout_marginStart="4dp"
                        android:text="@string/ultimi_gestiti"
                        android:textColor="#1565C0"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:backgroundTint="#E0E0E0" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!--
            Testata tabella: fissa sopra la lista (non scorre, è un sibling della
            ListView, non un header interno). Visibile solo a ricerca avviata, come
            barraPaginazione. Ogni colonna ordinabile ha una coppia di frecce ▲▼:
            quella attiva (colore blu) indica la colonna/direzione di ordinamento
            corrente; il tag di ogni colonna è il nome del campo DB da ordinare.
        -->
        <LinearLayout
            android:id="@+id/headerTabella"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#EEEEEE"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/colCodice"
                android:layout_width="0dp"
                android:layout_weight="14"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:tag="codice_esterno"
                android:onClick="ordinaPerColonna">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Cod."
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#444444"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="2dp">

                    <TextView
                        android:id="@+id/arrowUpCodice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▲"
                        android:textSize="7sp"
                        android:textColor="#BBBBBB" />

                    <TextView
                        android:id="@+id/arrowDownCodice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textSize="7sp"
                        android:textColor="#BBBBBB" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/colRagioneSociale"
                android:layout_width="0dp"
                android:layout_weight="32"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:tag="ragione_sociale"
                android:onClick="ordinaPerColonna">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Ragione sociale"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#444444"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="2dp">

                    <TextView
                        android:id="@+id/arrowUpRagione"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▲"
                        android:textSize="7sp"
                        android:textColor="#BBBBBB" />

                    <TextView
                        android:id="@+id/arrowDownRagione"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textSize="7sp"
                        android:textColor="#BBBBBB" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/colVia"
                android:layout_width="0dp"
                android:layout_weight="24"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:tag="indirizzo"
                android:onClick="ordinaPerColonna">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Via"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#444444"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="2dp">

                    <TextView
                        android:id="@+id/arrowUpVia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▲"
                        android:textSize="7sp"
                        android:textColor="#BBBBBB" />

                    <TextView
                        android:id="@+id/arrowDownVia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textSize="7sp"
                        android:textColor="#BBBBBB" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/colCitta"
                android:layout_width="0dp"
                android:layout_weight="20"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:tag="citta"
                android:onClick="ordinaPerColonna">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Città"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#444444"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="2dp">

                    <TextView
                        android:id="@+id/arrowUpCitta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▲"
                        android:textSize="7sp"
                        android:textColor="#BBBBBB" />

                    <TextView
                        android:id="@+id/arrowDownCitta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textSize="7sp"
                        android:textColor="#BBBBBB" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/colProvincia"
                android:layout_width="0dp"
                android:layout_weight="10"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:tag="provincia"
                android:onClick="ordinaPerColonna">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Prov."
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#444444"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="2dp">

                    <TextView
                        android:id="@+id/arrowUpProvincia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▲"
                        android:textSize="7sp"
                        android:textColor="#BBBBBB" />

                    <TextView
                        android:id="@+id/arrowDownProvincia"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="▼"
                        android:textSize="7sp"
                        android:textColor="#BBBBBB" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/wrapper_lista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/textViewNessunDato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="32dp"
                android:text="@string/nessun_dato_trovato"
                android:textColor="#999999"
                android:textSize="14sp"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- Barra di paginazione: pagina/risultati/pagine + prec/succ -->
        <LinearLayout
            android:id="@+id/barraPaginazione"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/textViewPaginaInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#666666"
                android:text="" />

            <EditText
                android:id="@+id/editTextRisultatiPerPagina"
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:background="@drawable/bg_input_outline"
                android:inputType="number"
                android:maxLength="3"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="#1565C0"
                android:imeOptions="actionDone" />

            <TextView
                android:id="@+id/textViewPaginaInfo2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="12sp"
                android:textColor="#666666"
                android:text="" />

            <ImageButton
                android:id="@+id/buttonPaginaPrec"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back"
                android:tint="#1565C0"
                android:onClick="paginaPrecedente"
                android:contentDescription="Pagina precedente" />

            <ImageButton
                android:id="@+id/buttonPaginaSucc"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_forward"
                android:tint="#1565C0"
                android:onClick="paginaSuccessiva"
                android:contentDescription="Pagina successiva" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
