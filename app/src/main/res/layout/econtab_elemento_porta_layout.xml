<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout
        android:id="@+id/econtab_elemento"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/immagine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentLeft="true"
           
            android:scaleType="fitXY"
            android:src="@drawable/porta_orizzontale" />

        <Button
            android:id="@+id/button_ruota"
            android:layout_width="@dimen/altezza_campo"
            android:layout_height="@dimen/altezza_campo"
            android:layout_below="@+id/immagine"
            android:layout_alignParentLeft="true"
            android:layout_marginTop="@dimen/margine"
            android:background="@android:drawable/ic_menu_rotate" />

    </RelativeLayout>
