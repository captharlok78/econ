<?xml version="1.0" encoding="utf-8"?>
<!--
    Finestra di una riga del rapportino (GESTIONE_RAPPORTINI.md §12.2): la stessa per Manodopera, Viaggio e Articolo;
    PopupRigaRapportino mostra solo le parti che servono alla categoria del tipo.
    Stile dei modali (STUDIO_MODALI_APP.md): campi bordati con l'etichetta nel bordo, tendine con lo stesso aspetto.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/sezione_articolo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- pulsante barcode comune (pulsante_leggi_barcode): legge e cerca l'articolo -->
                <include
                    layout="@layout/pulsante_leggi_barcode"
                    android:layout_width="56dp"
                    android:layout_height="48dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_tab_listino"
                    style="@style/Econ.Pulsante.Secondario"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/listino" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_tab_nuovo_articolo"
                    style="@style/Econ.Pulsante.Secondario"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/nuovo_articolo" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pannello_listino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="top"
                    android:orientation="horizontal">

                <!-- tendina con l'etichetta nel bordo, come i campi del template -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp">

                    <Spinner
                        android:id="@+id/spinner_costruttore"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/econ_scelta_bordata"
                        android:paddingStart="4dp"
                        android:paddingEnd="36dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="10dp"
                        android:background="#FFFFFF"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/costruttore"
                        android:textColor="@color/econ_testo_secondario"
                        android:textSize="12sp" />
                </FrameLayout>
                <!-- tendina con l'etichetta nel bordo, come i campi del template -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="8dp">

                    <Spinner
                        android:id="@+id/spinner_linea"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/econ_scelta_bordata"
                        android:paddingStart="4dp"
                        android:paddingEnd="36dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="10dp"
                        android:background="#FFFFFF"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="@string/linea"
                        android:textColor="@color/econ_testo_secondario"
                        android:textSize="12sp" />
                </FrameLayout>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/box_articolo"
                    style="@style/Econ.Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/articolo"
                    app:placeholderText="@string/cerca_3_lettere">

                    <com.ncfsistemi.econ.views.CampoRicerca
                        android:id="@+id/campo_articolo"
                        style="@style/Econ.CampoTesto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions" android:completionThreshold="3" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/pannello_nuovo_articolo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="top"
                    android:orientation="horizontal">

                <!-- tendina con l'etichetta nel bordo, come i campi del template -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/spinner_nuovo_settore"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@drawable/econ_scelta_bordata"
                            android:paddingStart="4dp"
                            android:paddingEnd="36dp" />

                        <TextView
                            android:id="@+id/button_piu_settore"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="10dp"
                        android:background="#FFFFFF"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Settore"
                        android:textColor="@color/econ_testo_secondario"
                        android:textSize="12sp" />
                </FrameLayout>
                <!-- tendina con l'etichetta nel bordo, come i campi del template -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/spinner_nuovo_costruttore"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@drawable/econ_scelta_bordata"
                            android:paddingStart="4dp"
                            android:paddingEnd="36dp" />

                        <TextView
                            android:id="@+id/button_piu_costruttore"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="10dp"
                        android:background="#FFFFFF"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Costruttore"
                        android:textColor="@color/econ_testo_secondario"
                        android:textSize="12sp" />
                </FrameLayout>
                <!-- tendina con l'etichetta nel bordo, come i campi del template -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/spinner_nuovo_linea"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@drawable/econ_scelta_bordata"
                            android:paddingStart="4dp"
                            android:paddingEnd="36dp" />

                        <TextView
                            android:id="@+id/button_piu_linea"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="4dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="10dp"
                        android:background="#FFFFFF"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:text="Linea"
                        android:textColor="@color/econ_testo_secondario"
                        android:textSize="12sp" />
                </FrameLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="top"
                    android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/box_nuovo_codice"
                    style="@style/Econ.Campo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"
                    android:hint="Codice articolo"
                    app:placeholderText="Automatico">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_nuovo_codice"
                        style="@style/Econ.CampoTesto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters|textNoSuggestions" android:maxLength="50" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/box_nuovo_barcode"
                    style="@style/Econ.Campo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="8dp"
                    android:hint="Barcode"
                    app:placeholderText="Facoltativo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_nuovo_barcode"
                        style="@style/Econ.CampoTesto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textNoSuggestions" android:maxLength="50" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/sezione_nuovo_prezzo_vendita"
                    style="@style/Econ.Campo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="8dp"
                    android:hint="Prezzo di vendita €"
                    app:placeholderText="Facoltativo">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_nuovo_prezzo_vendita"
                        style="@style/Econ.CampoTesto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/box_nuovo_descrizione"
                    style="@style/Econ.Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Descrizione *"
                    app:placeholderText="Es. Cavo FG16OR16 3x2,5 mm²">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_nuovo_descrizione"
                        style="@style/Econ.CampoTesto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences|textMultiLine" android:maxLength="255" android:maxLines="3" />
                </com.google.android.material.textfield.TextInputLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_nuovo_foto"
                        android:layout_width="96dp"
                        android:layout_height="72dp"
                        android:background="@drawable/econ_campo_bordato"
                        android:contentDescription="Foto dell'articolo"
                        android:scaleType="centerCrop" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_nuovo_foto"
                        style="@style/Econ.Pulsante.Secondario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Scatta foto" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_scegli_immagine"
                        style="@style/Econ.Pulsante.Secondario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Scegli immagine" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_togli_foto"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Togli"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/check_nuovo_listino_ditta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:checked="true"
                    android:text="Aggiungi al mio listino" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal">

        <!-- tendina con l'etichetta nel bordo, come i campi del template -->
        <FrameLayout
            android:id="@+id/sezione_tipo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <Spinner
                android:id="@+id/spinner_tipo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/econ_scelta_bordata"
                android:paddingStart="4dp"
                android:paddingEnd="36dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:background="#FFFFFF"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:id="@+id/etichetta_tipo"
                android:text="@string/tipo"
                android:textColor="@color/econ_testo_secondario"
                android:textSize="12sp" />
        </FrameLayout>
        <!-- tendina con l'etichetta nel bordo, come i campi del template -->
        <FrameLayout
            android:id="@+id/sezione_utente"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp">

            <Spinner
                android:id="@+id/spinner_utente"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/econ_scelta_bordata"
                android:paddingStart="4dp"
                android:paddingEnd="36dp" />

            <!-- piu' utenti (manodopera): nomi scelti, toccando si apre l'elenco a spunta -->
            <TextView
                android:id="@+id/text_utenti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/econ_campo_bordato"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/econ_testo"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/etichetta_utente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:background="#FFFFFF"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/utente"
                android:textColor="@color/econ_testo_secondario"
                android:textSize="12sp" />
        </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sezione_orari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/box_ora_inizio"
            style="@style/Econ.Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:hint="@string/ora_partenza"
            app:placeholderText="--:--">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_ora_inizio"
                style="@style/Econ.CampoTesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" android:focusable="false" android:cursorVisible="false" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/box_ora_fine"
            style="@style/Econ.Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:hint="@string/ora_arrivo"
            app:placeholderText="--:--">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_ora_fine"
                style="@style/Econ.CampoTesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" android:focusable="false" android:cursorVisible="false" />
        </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/box_quantita"
            style="@style/Econ.Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:hint="@string/quantita">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_quantita"
                style="@style/Econ.CampoTesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" android:selectAllOnFocus="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <!-- tendina con l'etichetta nel bordo, come i campi del template -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp">

            <Spinner
                android:id="@+id/spinner_unita"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/econ_scelta_bordata"
                android:paddingStart="4dp"
                android:paddingEnd="36dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:background="#FFFFFF"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/unita_misura"
                android:textColor="@color/econ_testo_secondario"
                android:textSize="12sp" />
        </FrameLayout>
        </LinearLayout>
        <!-- tendina con l'etichetta nel bordo, come i campi del template -->
        <FrameLayout
            android:id="@+id/sezione_riga_ordine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <Spinner
                android:id="@+id/spinner_riga_ordine"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/econ_scelta_bordata"
                android:paddingStart="4dp"
                android:paddingEnd="36dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:background="#FFFFFF"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:text="@string/riga_ordine"
                android:textColor="@color/econ_testo_secondario"
                android:textSize="12sp" />
        </FrameLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/box_note_riga"
            style="@style/Econ.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/note">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_note_riga"
                style="@style/Econ.CampoTesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences|textMultiLine" android:maxLength="255" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:id="@+id/sezione_assistenza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/box_mesi_assistenza"
                style="@style/Econ.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/assistenza_tra_mesi">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_mesi_assistenza"
                    style="@style/Econ.CampoTesto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" android:maxLength="3" android:selectAllOnFocus="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/text_assistenza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sezione_prezzo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/label_prezzo"
            style="@style/Econ.Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:hint="@string/costo_fisso">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_prezzo"
                style="@style/Econ.CampoTesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" android:selectAllOnFocus="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <!-- "A costo" in un riquadro alto come i campi, cosi' la riga e' uniforme -->
        <FrameLayout
            android:id="@+id/riquadro_a_costo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginTop="17dp"
            android:background="@drawable/econ_campo_bordato"
            android:paddingStart="8dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/check_a_costo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/a_costo"
                android:textColor="@color/econ_testo"
                android:textSize="16sp" />
        </FrameLayout>
        <!-- solo nelle righe di preventivo/ordine (PopupRigaRapportino in modo documento): sconto dell'articolo, operatori del lavoro -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/label_sconto"
            style="@style/Econ.Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:hint="Sconto %"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_sconto"
                style="@style/Econ.CampoTesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" android:selectAllOnFocus="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/label_operatori"
            style="@style/Econ.Campo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginTop="8dp"
            android:hint="@string/operatori"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_num_operatori"
                style="@style/Econ.CampoTesto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" android:selectAllOnFocus="true" />
        </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
