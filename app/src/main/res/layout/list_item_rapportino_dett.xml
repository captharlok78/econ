<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/relative_principale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
    android:background="@drawable/bg_econtab_bordo_bianco"
    android:paddingBottom="@dimen/margine"
    android:paddingTop="@dimen/margine"
         >
    <TextView
        android:id="@+id/tipo_manodopera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_toLeftOf="@+id/ore"
        android:text="Passaggio cavi" />
    <TextView
        android:id="@+id/nota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_alignParentLeft="true"
        android:layout_below="@+id/tipo_manodopera"
        style="@style/TestoPiccolo"
        android:text="Nota" />

    <TextView
        android:id="@+id/ore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="0.15"

        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"

        android:text="Ore: 15" />
    </RelativeLayout>

