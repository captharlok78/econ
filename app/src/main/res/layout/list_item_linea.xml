<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" 
    android:paddingTop="@dimen/margine"
    android:paddingBottom="@dimen/margine"
 	android:paddingRight="@dimen/margine"
 	android:paddingLeft="?android:attr/expandableListPreferredItemPaddingLeft"
 	android:minHeight="@dimen/altezza_item"
    >

    <TextView
        android:id="@+id/linea"
        style="@style/TestoPiccolo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        
        android:layout_alignParentLeft="true"
        android:layout_toLeftOf="@+id/buttonPlacche"
        android:layout_centerVertical="true"
       
        android:text="Linea" />

    <Button
        android:id="@+id/buttonPlacche"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/altezza_campo_doppia"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:background="@drawable/button_econtab_semitrasparente"
       
        android:text="@string/placche"
        android:textAllCaps="true"
        android:textSize="@dimen/testo_immagine"
        android:focusable="false" />

</RelativeLayout>