<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra in fondo alle liste standard (una sola per tutti i moduli, gestita da EconListaStandardController):
    pagina / risultati per pagina / trovati, esporta in xls, pagina precedente / successiva.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/barraPaginazione"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="4dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/textViewPaginaInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#666666"
        android:text="" />

    <EditText
        android:id="@+id/editTextRisultatiPerPagina"
        android:layout_width="36dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:gravity="center"
        android:background="@drawable/bg_input_outline"
        android:inputType="number"
        android:maxLength="3"
        android:singleLine="true"
        android:textSize="12sp"
        android:textColor="#1565C0"
        android:imeOptions="actionDone" />

    <TextView
        android:id="@+id/textViewPaginaInfo2"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textColor="#666666"
        android:text="" />

    <!-- Esporta in xls tutti i risultati della ricerca (solo liste tabellari): glifo FaIcone dal controller -->
    <TextView
        android:id="@+id/buttonEsportaXls"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:visibility="gone"
        android:contentDescription="Esporta in xls" />

    <ImageButton
        android:id="@+id/buttonPaginaPrec"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_back"
        android:tint="#1565C0"
        android:contentDescription="Pagina precedente" />

    <ImageButton
        android:id="@+id/buttonPaginaSucc"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_forward"
        android:tint="#1565C0"
        android:contentDescription="Pagina successiva" />

</LinearLayout>
