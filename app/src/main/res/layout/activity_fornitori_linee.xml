<?xml version="1.0" encoding="utf-8"?>
<!--
    Fornitori/Linee (Listini, livello 1): resta su ExpandableListView/adapter raggruppato
    proprio (EconExpListViewAdapter), non sul controller condiviso degli altri moduli -
    i gruppi (Costruttori) e le relative Linee non sono righe piatte. Adotta comunque la
    stessa testata standard e lo stesso stile di form filtri/paginazione degli altri moduli,
    paginando per Costruttore (gruppo), non per riga.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <include
        android:id="@+id/footerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/footer" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@+id/footerview"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/header_lista_standard" />

            <LinearLayout
                android:id="@+id/cardFiltri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_filtri"
                android:layout_margin="8dp"
                android:padding="10dp">

                <EditText
                    android:id="@+id/editText_filtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_input_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:hint="@string/cerca"
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />

                <include layout="@layout/filtri_azioni_standard" />

            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/wrapper_lista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ExpandableListView
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/textViewNessunDato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="32dp"
                android:text="@string/nessun_dato_trovato"
                android:textColor="#999999"
                android:textSize="14sp"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- Paginazione per Costruttore (gruppo), non per riga. -->
        <include layout="@layout/barra_paginazione_standard" />

    </LinearLayout>

</RelativeLayout>
