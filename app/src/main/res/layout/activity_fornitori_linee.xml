<?xml version="1.0" encoding="utf-8"?>
<!--
    Fornitori/Linee (Listini, livello 1): resta su ExpandableListView/adapter raggruppato
    proprio (EConTabExpListViewAdapter), non sul controller condiviso degli altri moduli -
    i gruppi (Costruttori) e le relative Linee non sono righe piatte. Adotta comunque la
    stessa testata standard e lo stesso stile di form filtri/paginazione degli altri moduli,
    paginando per Costruttore (gruppo), non per riga.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <include
        android:id="@+id/footerview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/footer" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_above="@+id/footerview"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/header_lista_standard" />

            <LinearLayout
                android:id="@+id/cardFiltri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_filtri"
                android:layout_margin="8dp"
                android:padding="10dp">

                <EditText
                    android:id="@+id/editText_filtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:background="@drawable/bg_input_outline"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:hint="@string/cerca"
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />

                <include layout="@layout/filtri_azioni_standard" />

            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/wrapper_lista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ExpandableListView
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/textViewNessunDato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="32dp"
                android:text="@string/nessun_dato_trovato"
                android:textColor="#999999"
                android:textSize="14sp"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- Paginazione per Costruttore (gruppo), non per riga. -->
        <LinearLayout
            android:id="@+id/barraPaginazione"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/textViewPaginaInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#666666"
                android:text="" />

            <EditText
                android:id="@+id/editTextRisultatiPerPagina"
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:gravity="center"
                android:background="@drawable/bg_input_outline"
                android:inputType="number"
                android:maxLength="3"
                android:singleLine="true"
                android:textSize="12sp"
                android:textColor="#1565C0"
                android:imeOptions="actionDone" />

            <TextView
                android:id="@+id/textViewPaginaInfo2"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="12sp"
                android:textColor="#666666"
                android:text="" />

            <ImageButton
                android:id="@+id/buttonPaginaPrec"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back"
                android:tint="#1565C0"
                android:contentDescription="Pagina precedente" />

            <ImageButton
                android:id="@+id/buttonPaginaSucc"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_forward"
                android:tint="#1565C0"
                android:contentDescription="Pagina successiva" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
