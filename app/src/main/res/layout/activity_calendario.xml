<?xml version="1.0" encoding="utf-8"?>
<!--
    Calendario personale (CalendarioActivity, CALENDARIO_PERSONALE.md): settimana (predefinita) o mese con le ore
    dell'utente nei rapportini e, con la pianificazione, i suoi cantieri pianificati. Giorni costruiti dal codice.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1565C0"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="Indietro"
            android:onClick="chiudi"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/calendario"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vistaSettimana"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:onClick="vistaSettimana"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Settimana"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/vistaMese"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:gravity="center"
            android:onClick="vistaMese"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Mese"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- periodo: indietro, titolo, avanti, oggi; sotto i totali -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/periodoPrima"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Periodo precedente"
            android:gravity="center"
            android:onClick="prima" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/periodoTitolo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/periodoTotali"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#616161"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/periodoDopo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Periodo successivo"
            android:gravity="center"
            android:onClick="dopo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_input_outline"
            android:gravity="center"
            android:onClick="oggi"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Oggi"
            android:textColor="#1565C0"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scorrimento"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contenuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>
</LinearLayout>
