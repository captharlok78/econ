<?xml version="1.0" encoding="utf-8"?>
<!-- Quantita' di un elemento (stile dei modali, STUDIO_MODALI_APP.md) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linear_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="4dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_qta"
        style="@style/Econ.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/quantita">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editText_qta"
            style="@style/Econ.CampoTesto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" android:maxLength="6" android:selectAllOnFocus="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/textView_composizione"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/composizione"
        android:textColor="@color/econ_testo_secondario"
        android:textSize="14sp" />
</LinearLayout>
