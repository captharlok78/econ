<?xml version="1.0" encoding="utf-8"?>
<!--
    Footer condiviso dalle schermate dei moduli (Cantieri, Clienti, Preventivi,
    Ordini, ecc.). Per ora non mostra nulla: né utente/ditta (si vedono nella barra
    in alto della home) né logout (visibile solo in home, activity_menu.xml).
    Tenuto come contenitore vuoto/nascosto invece di essere rimosso dai singoli
    layout, così le Activity che lo includono restano invariate se in futuro ci
    si mette di nuovo qualcosa.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/footer"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:visibility="gone">

    <!-- Nascosto: richiesto da EConTabActivity per indietro() -->
    <TextView
        android:id="@+id/textViewIndietro"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:onClick="indietro" />

</LinearLayout>
