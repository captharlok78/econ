<?xml version="1.0" encoding="utf-8"?>
<!--
    Riga tabellare: le colonne (peso 14/32/24/20/10) devono restare allineate con
    quelle della testata fissa in activity_clienti.xml (id headerTabella).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/codice_esterno"
        android:layout_width="0dp"
        android:layout_weight="14"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#666666"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/ragione_sociale"
        android:layout_width="0dp"
        android:layout_weight="32"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingEnd="4dp" />

    <TextView
        android:id="@+id/indirizzo"
        android:layout_width="0dp"
        android:layout_weight="24"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#333333"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingEnd="4dp" />

    <TextView
        android:id="@+id/citta"
        android:layout_width="0dp"
        android:layout_weight="20"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#333333"
        android:singleLine="true"
        android:ellipsize="end"
        android:paddingEnd="4dp" />

    <TextView
        android:id="@+id/provincia"
        android:layout_width="0dp"
        android:layout_weight="10"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#333333"
        android:singleLine="true"
        android:ellipsize="end" />

</LinearLayout>
