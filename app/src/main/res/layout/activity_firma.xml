<?xml version="1.0" encoding="utf-8"?>
<!--
  Firma del cliente a schermo intero (FirmaActivity, GESTIONE_RAPPORTINI.md §13): testata standard, nome di chi firma,
  area bianca in cui firmare con il dito, Annulla · Pulisci · Salva in fondo come nella maschera del rapportino.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/header_dettaglio_standard" />

    <EditText
        android:id="@+id/edit_firma_nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:hint="Nome e cognome di chi firma"
        android:inputType="textPersonName|textCapWords"
        android:maxLength="100"
        android:textSize="20sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:layout_weight="1"
        android:background="#BDBDBD"
        android:padding="1dp">

        <com.ncfsistemi.econ.views.FirmaView
            android:id="@+id/firma_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- linea su cui firmare e suggerimento: non ricevono i tocchi, restano sotto il tratto -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:layout_marginBottom="72dp"
            android:background="#E0E0E0"
            android:clickable="false" />

        <TextView
            android:id="@+id/text_firma_suggerimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:clickable="false"
            android:text="Firma qui con il dito"
            android:textColor="#BDBDBD"
            android:textSize="28sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal">

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:backgroundTint="#E0E0E0"
            android:onClick="annulla"
            android:text="@string/annulla"
            android:textColor="#1565C0"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_pulisci"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:layout_weight="1"
            android:backgroundTint="#E0E0E0"
            android:onClick="pulisci"
            android:text="Pulisci"
            android:textColor="#1565C0"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_salva_firma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="1dp"
            android:layout_weight="1"
            android:backgroundTint="#1565C0"
            android:enabled="false"
            android:onClick="salva"
            android:text="@string/salva"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
