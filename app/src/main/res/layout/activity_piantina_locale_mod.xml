<?xml version="1.0" encoding="utf-8"?>
<!--
    Piantina del locale (PiantinaLocaleModActivity): stessa pagina delle form del template (testata standard, card con
    la sezione, piede Annulla/Salva); dentro la griglia da toccare e le forme pronte.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/econ_sfondo"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/header_dettaglio_standard" />

    <com.google.android.material.card.MaterialCardView
        style="@style/Econ.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="4dp"
            android:paddingBottom="14dp">

            <include
                android:id="@+id/sezione_piantina"
                layout="@layout/sezione_standard" />

            <FrameLayout
                android:id="@+id/wrapper_griglia"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="@dimen/margine">

                <com.ncfsistemi.econ.views.EconPiantinaGridView
                    android:id="@+id/gridView_piantina"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:numColumns="10" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Forme pronte"
                android:textColor="@color/econ_testo_secondario"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:id="@+id/horizontalScrollView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/forme"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:divider="@drawable/divider_tab"
                    android:orientation="horizontal"
                    android:showDividers="middle" >

                    <Button
                        android:id="@+id/button_pianta_1111"
                        android:layout_width="@dimen/altezza_item"
                        android:layout_height="@dimen/altezza_item"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/altezza_campo"
                        android:background="@drawable/pianta_1111"
                        android:onClick="impostaPianta" />

                    <Button
                        android:id="@+id/button_pianta_rectvert"
                        android:layout_width="@dimen/altezza_item"
                        android:layout_height="@dimen/altezza_item"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/altezza_campo"
                        android:background="@drawable/pianta_rect_vert"
                        android:onClick="impostaPianta" />

                    <Button
                        android:id="@+id/button_pianta_rectoriz"
                        android:layout_width="@dimen/altezza_item"
                        android:layout_height="@dimen/altezza_item"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/altezza_campo"
                        android:background="@drawable/pianta_rect_oriz"
                        android:onClick="impostaPianta" />

                    <Button
                        android:id="@+id/button_pianta_1110"
                        android:layout_width="@dimen/altezza_item"
                        android:layout_height="@dimen/altezza_item"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/altezza_campo"
                        android:background="@drawable/pianta_1110"
                        android:onClick="impostaPianta" />

                    <Button
                        android:id="@+id/button_pianta_1101"
                        android:layout_width="@dimen/altezza_item"
                        android:layout_height="@dimen/altezza_item"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/altezza_campo"
                        android:background="@drawable/pianta_1101"
                        android:onClick="impostaPianta" />

                    <Button
                        android:id="@+id/button_pianta_1011"
                        android:layout_width="@dimen/altezza_item"
                        android:layout_height="@dimen/altezza_item"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/altezza_campo"
                        android:background="@drawable/pianta_1011"
                        android:onClick="impostaPianta" />

                    <Button
                        android:id="@+id/button_pianta_0111"
                        android:layout_width="@dimen/altezza_item"
                        android:layout_height="@dimen/altezza_item"
                        android:layout_gravity="center"
                        android:layout_margin="@dimen/altezza_campo"
                        android:background="@drawable/pianta_0111"
                        android:onClick="impostaPianta" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <include
        android:id="@+id/footer_dettaglio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/footer_dett" />

</LinearLayout>
