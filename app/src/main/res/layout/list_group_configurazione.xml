<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" 
    android:paddingTop="13sp"
    android:paddingBottom="13sp"
    android:paddingRight="@dimen/margine"

    >

    <TextView
        android:id="@+id/nomeCategoria"
        style="@style/TestoNeroGrandeSingolaLinea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@+id/buttonNuovo"
        android:paddingLeft="?android:attr/expandableListPreferredItemPaddingLeft"
        
        android:text="Categoria" />

    <Button
        android:id="@+id/buttonNuovo"
        style="@style/bottoneListaGrande"
       
        android:focusable="false"
        android:layout_alignParentRight="true"
        android:background="@drawable/nuovo_selector"
        
        android:layout_centerVertical="true" />

</RelativeLayout>