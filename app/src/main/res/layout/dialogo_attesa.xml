<?xml version="1.0" encoding="utf-8"?>
<!-- Attesa (EconDialogo.attesa): rotellina o barra d'avanzamento e testo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/attesa_rotellina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/econ_primario"
            app:indicatorSize="36dp"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/attesa_testo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:textColor="@color/econ_testo_corpo"
            android:textSize="15sp" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/attesa_barra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="100"
        android:visibility="gone"
        app:indicatorColor="@color/econ_primario"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp" />
</LinearLayout>
