<?xml version="1.0" encoding="utf-8"?>
<!-- Finestra a tutta pagina: barra blu comune (finestra_testata, STUDIO_MODALI_APP.md) e contenuto sullo sfondo dell'app -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/econ_sfondo"
    android:orientation="vertical">

    <include layout="@layout/finestra_testata" />

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    
    android:padding="@dimen/margine" >

    <RelativeLayout
        android:id="@+id/contenitore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

       
        <ImageButton
            android:id="@+id/imageButton_chiudi"
            android:visibility="gone"
            style="@style/bottoneLista"
            android:layout_alignParentRight="true"
            android:onClick="chiudi"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_bottone_grigio_arrotondato"
            android:scaleType="fitXY"
            android:src="@android:drawable/ic_delete" />
        
      

        <TextView
            android:id="@+id/textViewTitolo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:textAllCaps="false"
            android:text="@string/locali_preferiti"
            style="@style/Econ.Dialogo.TitoloTestata" />

        <EditText
            android:id="@+id/editText_filtra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_alignParentRight="true"
            android:layout_below="@+id/textViewTitolo"
            android:layout_marginTop="@dimen/margine"
            android:ems="10"
            android:hint="@string/cerca"
            android:singleLine="true" >

            <requestFocus />
        </EditText>
        
        <GridView
        android:id="@+id/griglia_locali"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:numColumns="auto_fit"
        android:columnWidth="@dimen/larghezza_elemento"
       
        android:horizontalSpacing="@dimen/padding_drag"
        android:verticalSpacing="@dimen/padding_drag"
        android:layout_marginTop="@dimen/margine"
        android:layout_marginBottom="@dimen/margine"
        android:layout_below="@+id/editText_filtra" >
      
    </GridView>
        
    </RelativeLayout>

</FrameLayout>
</LinearLayout>
