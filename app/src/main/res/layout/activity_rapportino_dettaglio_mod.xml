<?xml version="1.0" encoding="utf-8"?>
<!--
    Rapportino (GESTIONE_RAPPORTINI.md §12.1): testata standard con lo stato, operatore e data, cliente / cantiere / ordine
    con ricerca, note, i tre pulsanti che aprono le finestre delle righe, la tabella delle righe (testata fissa) e in fondo
    Annulla · Firma · Invia mail · Salva · Conferma.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/header_dettaglio_standard" />

        <TextView
            android:id="@+id/badge_stato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:elevation="5dp"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/campi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margine"
        android:paddingTop="@dimen/margine"
        android:paddingEnd="@dimen/margine">

        <!-- riga 1: operatore (chi compila, fisso) e data -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TestoIntestazione"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/operatore" />

            <TextView
                android:id="@+id/text_operatore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/TestoIntestazione"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/data" />

            <com.ncfsistemi.econ.views.EconCalendario
                android:id="@+id/edit_data"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- riga 2: cliente, cantiere, ordine (almeno uno); ricerca da 3 lettere, l'ordine anche toccando il campo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margine"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TestoIntestazione"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cliente" />

                <com.ncfsistemi.econ.views.CampoRicerca
                    android:id="@+id/campo_cliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cerca_3_lettere" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margine"
                android:orientation="vertical">

                <TextView
                    style="@style/TestoIntestazione"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cantiere" />

                <com.ncfsistemi.econ.views.CampoRicerca
                    android:id="@+id/campo_cantiere"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cerca_3_lettere" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margine"
                android:orientation="vertical">

                <TextView
                    style="@style/TestoIntestazione"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ordine" />

                <com.ncfsistemi.econ.views.CampoRicerca
                    android:id="@+id/campo_ordine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- riga 3: note -->
        <EditText
            android:id="@+id/editText_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margine"
            android:hint="@string/note_rapportino"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="255" />

        <!-- firma del cliente (GESTIONE_RAPPORTINI.md §13): anteprima, il tocco la mostra grande -->
        <LinearLayout
            android:id="@+id/riga_firma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margine"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:onClick="firma"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/img_firma"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:adjustViewBounds="true"
                android:background="#FFFFFF"
                android:contentDescription="Firma del cliente"
                android:maxWidth="240dp"
                android:padding="4dp" />

            <TextView
                android:id="@+id/text_firma"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="#546E7A"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- riga 4: nuove righe -->
        <LinearLayout
            android:id="@+id/pulsanti_righe"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="@dimen/margine"
            android:layout_marginBottom="@dimen/margine"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_manodopera"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#E3F2FD"
                android:onClick="nuovaManodopera"
                android:text="@string/aggiungi_manodopera"
                android:textColor="#1565C0"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_viaggio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#E3F2FD"
                android:onClick="nuovoViaggio"
                android:text="@string/aggiungi_viaggio"
                android:textColor="#1565C0"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_articolo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#E3F2FD"
                android:onClick="nuovoArticolo"
                android:text="@string/aggiungi_articolo"
                android:textColor="#1565C0"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- righe: testata fissa + lista (DettaglioTabellaAdapter) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/margine"
        android:layout_marginEnd="@dimen/margine"
        android:background="#FFFFFF">

        <include layout="@layout/dettaglio_tabella_standard" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/margine"
        android:orientation="horizontal">

        <Button
            android:id="@+id/button_annulla"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:backgroundTint="#E0E0E0"
            android:onClick="annulla"
            android:text="@string/annulla"
            android:textColor="#1565C0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Stampa con il modello della ditta (§15) -->
        <Button
            android:id="@+id/button_stampa"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:backgroundTint="#E0E0E0"
            android:onClick="stampa"
            android:text="Stampa"
            android:textColor="#1565C0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Firma del cliente (§13); Invia mail nascosto finche' non c'e' l'invio (§8.9) -->
        <Button
            android:id="@+id/button_firma"
            android:onClick="firma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:backgroundTint="#E0E0E0"
            android:text="@string/firma"
            android:textColor="#1565C0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_invia_mail"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:backgroundTint="#E0E0E0"
            android:text="@string/invia_mail"
            android:textColor="#1565C0"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_salva"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:backgroundTint="#1565C0"
            android:onClick="salva"
            android:text="@string/salva"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_conferma"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="1dp"
            android:backgroundTint="#2E7D32"
            android:onClick="conferma"
            android:text="@string/conferma"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <include layout="@layout/footer" />
</LinearLayout>
