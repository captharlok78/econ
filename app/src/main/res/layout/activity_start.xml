<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.ncfsistemi.econ.views.AtomView
        android:id="@+id/atomView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="64dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="iEcon"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_iecon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="iEcon"
            android:textColor="#FFFFFF"
            android:textSize="52sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/textViewVersione"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="v 2.0"
            android:textColor="#99FFFFFF"
            android:textSize="18sp" />

        <!-- editore (EDITORE_E_FIRMA.md) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/sfondo_logo_ncf"
                android:contentDescription="NCF Sistemi"
                android:padding="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_ncf" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="powered by NCF Sistemi"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
